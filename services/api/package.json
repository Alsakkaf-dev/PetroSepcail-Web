{
  "name": "@petrospecial/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "vercel-build": "npm run build --workspace=@petrospecial/contracts --workspace=@petrospecial/observability --workspace=@petrospecial/auth-shared --prefix ../.. && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.1.0",
    "@node-rs/argon2": "^2.0.2",
    "@petrospecial/auth-shared": "*",
    "@petrospecial/contracts": "*",
    "@petrospecial/observability": "*",
    "fastify": "^5.10.0",
    "jose": "^5.9.6",
    "minio": "^8.0.7",
    "nodemailer": "^9.0.3",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.11",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "node-pg-migrate": "^9.0.0"
  }
}
