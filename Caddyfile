# Caddyfile — single reverse-proxy front for every tier (ADR-12).
# Automatic HTTPS: Caddy issues a locally-trusted self-signed cert for
# non-public names (localhost/*.localhost) and a real Let's Encrypt cert
# the instant a public DOMAIN/ADMIN_DOMAIN/DRIVER_DOMAIN is set — no
# conditional config, no manual cert step (D-13). {$ACME_EMAIL} is only
# used by the ACME step, harmless when self-signing locally.

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	handle /api/* {
		reverse_proxy api:4000
	}
	handle /realtime* {
		reverse_proxy realtime:4001
	}
	# SF-01/PC-09 (S07): presigned MinIO URLs are signed against the
	# container-internal `minio` host — unreachable from a real browser.
	# Path-style proxy (strip the /media prefix so what MinIO receives
	# matches its own /<bucket>/<object> layout). Real bug caught live:
	# Caddy's reverse_proxy PRESERVES the client's original Host header by
	# default (it does not rewrite it to the upstream target) — MinIO's
	# SigV4 presigned URLs sign the `host` header (X-Amz-SignedHeaders=host),
	# so a pass-through Host of "localhost" broke every signature
	# (403 SignatureDoesNotMatch) until header_up explicitly forced it to
	# match what media/minioClient.ts signed against.
	handle_path /media/* {
		reverse_proxy minio:9000 {
			header_up Host minio:9000
		}
	}
	handle {
		reverse_proxy store:3000
	}
}

{$ADMIN_DOMAIN} {
	handle /api/* {
		reverse_proxy api:4000
	}
	handle /realtime* {
		reverse_proxy realtime:4001
	}
	# SF-01/PC-09 (S07): presigned MinIO URLs are signed against the
	# container-internal `minio` host — unreachable from a real browser.
	# Path-style proxy (strip the /media prefix so what MinIO receives
	# matches its own /<bucket>/<object> layout). Real bug caught live:
	# Caddy's reverse_proxy PRESERVES the client's original Host header by
	# default (it does not rewrite it to the upstream target) — MinIO's
	# SigV4 presigned URLs sign the `host` header (X-Amz-SignedHeaders=host),
	# so a pass-through Host of "localhost" broke every signature
	# (403 SignatureDoesNotMatch) until header_up explicitly forced it to
	# match what media/minioClient.ts signed against.
	handle_path /media/* {
		reverse_proxy minio:9000 {
			header_up Host minio:9000
		}
	}
	handle {
		reverse_proxy admin:3001
	}
}

{$DRIVER_DOMAIN} {
	handle /api/* {
		reverse_proxy api:4000
	}
	handle /realtime* {
		reverse_proxy realtime:4001
	}
	# SF-01/PC-09 (S07): presigned MinIO URLs are signed against the
	# container-internal `minio` host — unreachable from a real browser.
	# Path-style proxy (strip the /media prefix so what MinIO receives
	# matches its own /<bucket>/<object> layout). Real bug caught live:
	# Caddy's reverse_proxy PRESERVES the client's original Host header by
	# default (it does not rewrite it to the upstream target) — MinIO's
	# SigV4 presigned URLs sign the `host` header (X-Amz-SignedHeaders=host),
	# so a pass-through Host of "localhost" broke every signature
	# (403 SignatureDoesNotMatch) until header_up explicitly forced it to
	# match what media/minioClient.ts signed against.
	handle_path /media/* {
		reverse_proxy minio:9000 {
			header_up Host minio:9000
		}
	}
	handle {
		reverse_proxy driver:3002
	}
