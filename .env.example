# .env.example — v5.0, rewritten under D-15 (hosting/vendor pivot, 2026-07-23).
# Every value has a working Development default. Copy to `.env` with zero
# edits for `vercel dev` / `next dev` — no Docker required. Preview and
# Production change the vendor credentials (Vercel encrypted Environment
# Variables per environment) but nothing else — see
# platform-docs/00-master/09-deployment-and-infrastructure.md §2/§3 (v5.0)
# and platform-docs/00-master/07-technology-stack-decision.md (v5.0, ADR-15..22).
#
# Superseded file: the T1/T2/T3 self-hosted version of this file (DOMAIN/
# ADMIN_DOMAIN/DRIVER_DOMAIN/ACME_EMAIL/HTTP_PORT/HTTPS_PORT/MAILPIT_*/
# MINIO_*/POSTGRES_*/NOMINATIM_URL/OSRM_URL/PROMETHEUS_*/GRAFANA_* and the
# JWT/ZATCA `*_PATH` secret-file variables) is preserved in git history —
# see the commit that replaced it with this one.

# ---- Database — Neon / Vercel Postgres (ADR-15) ---------------------------
# Development: a Neon "dev" branch. Preview: Vercel's Neon integration
# injects a fresh per-branch DATABASE_URL automatically. Production: the
# Neon main branch's pooled connection string.
DATABASE_URL=postgres://petrospecial:petrospecial_dev_password@localhost:5432/petrospecial?sslmode=require
# Non-pooled connection, required by node-pg-migrate (Neon's pooler does not
# support the session-level features migrations need).
DIRECT_URL=postgres://petrospecial:petrospecial_dev_password@localhost:5432/petrospecial?sslmode=require

# ---- Realtime — Pusher Channels (ADR-16) -----------------------------------
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap2
# Client-side (browser) subscribe key — public by design, scoped by channel auth.
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=ap2

# ---- Storage — Vercel Blob (ADR-17) ----------------------------------------
BLOB_READ_WRITE_TOKEN=

# ---- Scheduled jobs — Vercel Cron + QStash (ADR-18) ------------------------
# Vercel Cron covers fixed-schedule jobs (points-expiry, campaign boundaries).
# QStash covers jobs that need reliable per-message delivery (outbox drain).
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Shared secret the Vercel Cron/QStash handler checks on inbound calls so the
# endpoint can't be triggered by anyone who finds the URL.
CRON_SECRET=dev_only_change_in_every_real_environment

# ---- Maps — Google Maps Platform (ADR-19) ----------------------------------
# RSK-020: requires a billing account on the Google Cloud project even for
# free-tier usage. Set a hard budget cap/alert the same day this key is
# created — see 11-risk-register.md RSK-020's mandatory mitigation.
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_DIRECTIONS_URL=https://maps.googleapis.com/maps/api/directions/json

# ---- Email — Resend (ADR-20) -----------------------------------------------
# resend | onscreen (RSK-018 fallback — used automatically if Resend errors
# or before RESEND_API_KEY is set, so Development works with zero signup).
EMAIL_MODE=onscreen
RESEND_API_KEY=
EMAIL_FROM=no-reply@petrospecial.com

# ---- ZATCA e-invoicing (ADR-11) — simulator is an in-app module now, not a
# separate container (D-15 folded the zatca-sim service into services/api) --
# simulator (Development/Preview) | real (Production, CSID adapter swap)
ZATCA_MODE=simulator
ZATCA_STAMP_KEY=

# ---- Auth / JWT (ADR-04, mechanism unchanged by D-15) ----------------------
# PEM values pasted directly as env vars (Vercel encrypted Environment
# Variables replace the old /run/secrets Docker volume — there is no
# secrets-file path anymore).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=2592000
# core.mfa_secrets.totp_secret at-rest encryption key (AES-256-GCM).
MFA_ENCRYPTION_KEY=

# ---- Payments (ADR-08/D-11) -------------------------------------------------
PAYMENTS_CARDS=off

# ---- Public base URLs ------------------------------------------------------
# Development: local `next dev`/`vercel dev` ports. Preview: Vercel assigns
# a per-branch URL automatically (read from VERCEL_URL — these three are for
# local dev only). Production: https://store.petrospecial.com and the
# admin/driver equivalents per D-01.
PUBLIC_BASE_URL=http://localhost:3000
PUBLIC_ADMIN_BASE_URL=http://localhost:3001
PUBLIC_DRIVER_BASE_URL=http://localhost:3002

# ---- Runtime -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
