# .env.example — every value has a working Tier-1 (localhost) default (ADR-14/D-13).
# Copy to `.env` with zero edits for local dev. Going live (T2) changes ONLY the
# values marked "T2/T3" below — see platform-docs/00-master/09-deployment-and-infrastructure.md §3.

# ---- Domains / TLS (ADR-12) ----------------------------------------------
# T2/T3: DOMAIN=store.petrospecial.com (D-01 subdomain decision)
DOMAIN=localhost
# SPEC-GAP: admin/driver local subdomains not named in D-01; least-surprising
# default chosen here. Confirm real T2/T3 values when S18/S11 go live.
ADMIN_DOMAIN=admin.localhost
DRIVER_DOMAIN=driver.localhost
# Used only for the ACME contact on a real DOMAIN; ignored for self-signed.
ACME_EMAIL=admin@petrospecial.com
PUBLIC_BASE_URL=https://localhost
PUBLIC_ADMIN_BASE_URL=https://admin.localhost
PUBLIC_DRIVER_BASE_URL=https://driver.localhost

# ---- Host ports (Caddy is the only public entrypoint; others are dev tools) ----
HTTP_PORT=80
HTTPS_PORT=443
MAILPIT_WEB_PORT=8025
MINIO_CONSOLE_PORT=9001
MINIO_API_PORT=9000

# ---- Postgres (ADR-01) ----------------------------------------------------
POSTGRES_USER=petrospecial
POSTGRES_PASSWORD=petrospecial_dev_password
POSTGRES_DB=petrospecial
POSTGRES_PORT=5432
DATABASE_URL=postgres://petrospecial:petrospecial_dev_password@postgres:5432/petrospecial

# ---- MinIO (ADR-06) --------------------------------------------------------
MINIO_ROOT_USER=petrospecial
MINIO_ROOT_PASSWORD=petrospecial_dev_password
MINIO_ENDPOINT=minio
MINIO_USE_SSL=false
MINIO_BUCKET_MEDIA=ps-media
MINIO_BUCKET_INVOICES=ps-invoices
MINIO_BUCKET_POD=ps-pod

# ---- Auth / JWT (ADR-04) — keys generated on first boot by scripts/init --
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=2592000
# core.mfa_secrets.totp_secret at-rest encryption key (AES-256-GCM), generated
# on first boot by scripts/init/generate-mfa-key.mjs (PC-AUTH-5, S02).
MFA_ENCRYPTION_KEY_PATH=/run/secrets/mfa_encryption.key

# ---- Email (ADR-10) --------------------------------------------------------
# catcher (T1 mailpit) | smtp (T2/T3 self-hosted Postfix) | onscreen (fallback)
EMAIL_MODE=catcher
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@petrospecial.com

# ---- ZATCA e-invoicing (ADR-11) — built in S15 ----------------------------
# simulator (T1/T2) | real (T3, CSID adapter swap)
ZATCA_MODE=simulator
ZATCA_SIM_URL=http://zatca-sim:4010
ZATCA_STAMP_KEY_PATH=/run/secrets/zatca_stamp_key.pem

# ---- Payments (ADR-08/D-11) ------------------------------------------------
PAYMENTS_CARDS=off

# ---- Maps / routing (ADR-09) — built in S11 -------------------------------
NOMINATIM_URL=http://nominatim:8080
OSRM_URL=http://osrm:5000

# ---- Service ports (container-internal, stable across tiers) -------------
STORE_PORT=3000
ADMIN_PORT=3001
DRIVER_PORT=3002
API_PORT=4000
REALTIME_PORT=4001
ZATCA_SIM_PORT=4010
WORKERS_HEALTH_PORT=4020

# ---- Internal service-to-service URLs (EP-PC-061 /ready, S03; health watcher, S06) --
API_URL=http://api:4000
REALTIME_URL=http://realtime:4001
MINIO_HEALTH_URL=http://minio:9000/minio/health/live

# ---- Observability (PC-10, S06) — `docker compose --profile observability up` --
PROMETHEUS_PORT=9090
LOKI_PORT=3100
GRAFANA_PORT=3300
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=petrospecial_dev_password

# ---- Runtime ----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
